# 复制为 .env 后填写账号密码；直接填写，不加引号。
# 原生监控按 raw 格式读取，密码中的 $、# 等字符会原样保留。
ZJU_USERNAME=
ZJU_PASSWORD=
ZJU_URL=https://net.zju.edu.cn/
# HTTPS 连接被关闭 / 重置 / 超时时使用同域名的 HTTP 登录入口；留空可禁用回退。
ZJU_HTTP_FALLBACK_URL=http://net.zju.edu.cn/srun_portal_pc?theme=zju
# 认证区域默认从门户 CONFIG.acid 自动读取；不要盲目填 1。
# ZJU_AC_ID=82
# 如学校调整认证地址，在 .env 中覆盖并重启后台监控。
ZJU_PORTAL_IP=10.50.254.11
CHECK_INTERVAL=30
LINK_RETRY_INTERVAL=5
ZJU_API_TIMEOUT=5
# Windows 原生入口自动恢复已有的 Wi-Fi 配置；按本机配置名称/接口名称修改。
# 将 ZJU_WIFI_PROFILE 留空可关闭系统 Wi-Fi 自动恢复。
ZJU_WIFI_PROFILE=ZJUWLAN
ZJU_WIFI_INTERFACE=WLAN
# Windows A/B 代理故障切换，显式启用。
# 0 使用原生单网络模式，1 启用原生双网络；两种模式均无需容器运行时。
ZJU_WIFI_FAILOVER=0
ZJU_WIFI_PROFILE_A=ZJUWLAN
ZJU_WIFI_PROFILE_B=ZJUWLAN-Secure
PROXY_CHECK_INTERVAL=60
PROXY_FAILURE_THRESHOLD=2
# 每个 socket 操作超时；CONNECT/TLS/响应阶段耗时可能叠加。
PROXY_CHECK_TIMEOUT=8
WIFI_CONNECT_TIMEOUT=30
# 同一网络连接请求失败/等待超时达到此次数后，限速尝试另一已保存网络。
WIFI_RESTORE_FAILURE_THRESHOLD=2
WIFI_FAILOVER_COOLDOWN=300
# 必须确认两个目标在当前 Clash 规则中走代理，而非 DIRECT；程序不修改规则。
PROXY_CHECK_URLS=https://www.google.com/generate_204,https://www.wikipedia.org/
# Windows 后台守护网易UU远程（1 开启，0 关闭），安装路径默认从注册表识别。
UU_REMOTE_MONITOR=1
# 自定义路径时指向安装根目录入口，不加引号；例如 C:\Path\To\GameViewer\GameViewer.exe
UU_REMOTE_EXE=
UU_REMOTE_CHECK_INTERVAL=5
# 升级进程退出且启动文件稳定后等待的秒数；普通退出也等待此时间。
UU_REMOTE_UPDATE_GRACE=30
# 发出启动请求后未出现主进程的重试间隔。
UU_REMOTE_START_RETRY=60
NETWORK_CHECK_TIMEOUT=5
NETWORK_CHECK_URLS=https://www.baidu.com
